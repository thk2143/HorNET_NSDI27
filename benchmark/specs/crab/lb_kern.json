{
  "_comment": "Fully symbolic input: no packet bytes, no length and no map entry fixed.",
  "exit_conditions": {
    "lb_forward_only": {
      "assert": "all",
      "cond": {"or": [
        {"not": {"and": [
          {"field": "eth_type", "value": "0x0800"},
          {"field": "ip_proto", "value": 6}
        ]}},
        {"and": [
          {"or": [{"ret": 2}, {"ret": 3}]},
          {"ret": 4, "op": "ne"}
        ]}
      ]}
    }
  }
}
